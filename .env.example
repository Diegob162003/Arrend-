# Copia este archivo como .env.local. Los valores de Supabase salen de `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Llave de sitio de PRUEBA de Cloudflare Turnstile (siempre aprueba). En producción va la real.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Muestra el botón "Continuar con Google" (requiere configurar Google en Supabase).
NEXT_PUBLIC_AUTH_GOOGLE=false

# Opcionales: sin valor quedan apagados.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
